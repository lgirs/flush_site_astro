---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gigsData from "../../data/gigs.json";
import venuesData from "../../config/gig_venues.json";

export const pageTitle = "Indie gigs around us";
export const pageTags = ["Gigs", "Helsinki", "Vantaa", "Tallinn"];

// --- FILTER LOGIC ---
const today = new Date();
today.setHours(0, 0, 0, 0);

// Filter gigs to only include today or future events
const upcomingGigs = gigsData.filter(gig => {
  const gigDate = new Date(gig.date);
  return gigDate >= today;
});

// Extract unique cities dynamically for the filter buttons
const cities = ["All", ...new Set(upcomingGigs.map(gig => gig.city))];
---

<BaseLayout title={pageTitle} description="An automated list of upcoming indie gigs around our stomping grounds.">
  <h1>{pageTitle}</h1>
  <p class="long-text">
    We went experimental and had some computer monkeys run around looking for gigs on our stomping grounds. This is a totally experimental page and you should verify all information with the actual venues. The genres are guess work by the computer monkeys and sometimes they miss or misinterpret important things so be careful.
  </p>

  <!-- City Filter Tags -->
  <div class="city-filter-container">
    {cities.map((city, index) => (
      <button 
        class={`city-tag ${index === 0 ? 'active' : ''}`} 
        data-city={city}
      >
        {city}
      </button>
    ))}
  </div>

  <div class="gig-list">
    {upcomingGigs.length === 0 ? (
      <p class="muted">No gigs found at the moment. Check back later!</p>
    ) : (
      <ul>
        {upcomingGigs.map(gig => (
          <li class="item" data-city={gig.city}>
            <span class="date">{gig.date}</span>
            <div class="venue-block">
              <span class="venue">{gig.venue}</span>
              <span class="city">{gig.city}</span>
            </div>
            <div class="event-wrapper">
              <span class="event">{gig.title}</span>
              {gig.genre && <span class="genre">{gig.genre}</span>}
            </div>
            <div class="action-cell">
              {gig.ticket_link && (
                <a href={gig.ticket_link} class="link" target="_blank" rel="noopener">Details →</a>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Tracked Venues Disclosure Section -->
  <div class="tracked-venues-section">
    <p class="venues-intro">These are all the venues the monkeys are looking at, trying to figure out if they have gigs going on:</p>
    <ul class="venues-grid">
      {venuesData.map(venue => (
        <li>
          <a href={venue.url} target="_blank" rel="noopener">{venue.name}</a>
          <span class="venue-city">({venue.city})</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tags = document.querySelectorAll('.city-tag');
    const items = document.querySelectorAll('.item');

    tags.forEach(tag => {
      tag.addEventListener('click', () => {
        tags.forEach(t => t.classList.remove('active'));
        tag.classList.add('active');

        const selectedCity = tag.getAttribute('data-city');

        items.forEach(item => {
          const itemCity = item.getAttribute('data-city');
          if (selectedCity === 'All' || itemCity === selectedCity) {
            (item as HTMLElement).style.display = 'grid';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .city-filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem 0;
  }

  .city-tag {
    background: transparent;
    border: 1px solid rgba(233, 232, 241, 0.2);
    color: inherit;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .city-tag:hover {
    border-color: var(--flush-yellow, #ffe600);
  }

  .city-tag.active {
    background: var(--flush-yellow, #ffe600);
    color: #000;
    border-color: var(--flush-yellow, #ffe600);
    font-weight: 700;
  }

  .gig-list ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }
  
  .item {
    display: grid;
    grid-template-columns: 11ch minmax(160px, 200px) 1fr auto; 
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(233, 232, 241, 0.08);
    font-size: 0.95rem;
  }
  
  .date {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
    font-size: 0.9rem;
  }
  
  .venue-block {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .venue {
    font-weight: 600;
    color: #fff;
  }

  .city {
    opacity: 0.5;
    font-size: 0.85rem;
  }
  
  .event-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75ch;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .event {
    color: #fff;
  }

  .genre {
    opacity: 0.45;
    font-size: 0.85rem;
  }

  .action-cell {
    text-align: right;
    white-space: nowrap;
  }

  .link {
    color: var(--flush-yellow, #ffe600);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .link:hover {
    text-decoration: underline;
  }
  
  .muted {
    opacity: 0.8;
    margin-top: 2rem;
  }

  /* Tracked Venues Footer Section Style */
  .tracked-venues-section {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(233, 232, 241, 0.08);
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .venues-intro {
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .venues-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .venues-grid li {
    display: inline-flex;
    gap: 0.35ch;
    align-items: baseline;
  }

  .venues-grid a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .venues-grid a:hover {
    color: var(--flush-yellow, #ffe600);
  }

  .venue-city {
    font-size: 0.9em;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-bottom: 1.25rem;
    }
    .date, .venue-block, .event-wrapper, .action-cell {
      grid-column: 1 / -1;
      text-align: left;
    }
    .venue-block {
      font-size: 1.05rem;
    }
    .action-cell {
      margin-top: 0.25rem;
    }
  }
</style>
