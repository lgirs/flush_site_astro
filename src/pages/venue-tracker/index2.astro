---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gigsData from "../../data/gigs.json";

export const pageTitle = "Venue Tracker";
export const pageTags = ["Gigs", "Helsinki", "Vantaa", "Tallinn"];

// --- FILTER LOGIC ---
const today = new Date();
today.setHours(0, 0, 0, 0);

// Filter gigs to only include today or future events
const upcomingGigs = gigsData.filter(gig => {
  const gigDate = new Date(gig.date);
  return gigDate >= today;
});

// Extract unique cities dynamically for the filter buttons
const cities = ["All", ...new Set(upcomingGigs.map(gig => gig.city))];
---

<BaseLayout title={pageTitle} description="An automated list of upcoming gigs at small venues in the region.">
  <h1>{pageTitle}</h1>
  <p class="long-text">
    This is <strong>automated by AI agents</strong> and refreshed twice a week. Always validate directly with the venue before trusting everything you see on this page.
  </p>

  <!-- City Filter Tags -->
  <div class="city-filter-container">
    {cities.map((city, index) => (
      <button 
        class={`city-tag ${index === 0 ? 'active' : ''}`} 
        data-city={city}
      >
        {city}
      </button>
    ))}
  </div>

  <div class="gig-list">
    {upcomingGigs.length === 0 ? (
      <p class="muted">No gigs found at the moment. Check back later!</p>
    ) : (
      <ul>
        {upcomingGigs.map(gig => (
          <li class="item" data-city={gig.city}>
            <span class="date">{gig.date}</span>
            <span class="venue">{gig.venue}</span>
            <div class="event-wrapper">
              <span class="event">{gig.title}</span>
              {gig.genre && <span class="genre">({gig.genre})</span>}
            </div>
            {gig.ticket_link ? (
              <a href={gig.ticket_link} class="link" target="_blank" rel="noopener">Details →</a>
            ) : (
              <span class="no-link">—</span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<script>
  // Client-side filtering logic for the city tags
  document.addEventListener('DOMContentLoaded', () => {
    const tags = document.querySelectorAll('.city-tag');
    const items = document.querySelectorAll('.item');

    tags.forEach(tag => {
      tag.addEventListener('click', () => {
        // Update active class on buttons
        tags.forEach(t => t.classList.remove('active'));
        tag.classList.add('active');

        const selectedCity = tag.getAttribute('data-city');

        // Show/Hide rows based on selected city
        items.forEach(item => {
          const itemCity = item.getAttribute('data-city');
          if (selectedCity === 'All' || itemCity === selectedCity) {
            (item as HTMLElement).style.display = 'grid';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  /* City Filter Tags Styling (Consistent with site branding) */
  .city-filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem 0;
  }

  .city-tag {
    background: transparent;
    border: 1px solid rgba(233, 232, 241, 0.2);
    color: inherit;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .city-tag:hover {
    border-color: var(--flush-yellow, #ffe600);
  }

  .city-tag.active {
    background: var(--flush-yellow, #ffe600);
    color: #000;
    border-color: var(--flush-yellow, #ffe600);
    font-weight: 700;
  }

  .gig-list ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }
  
  .item {
    display: grid;
    grid-template-columns: 10ch 1fr 5fr auto; 
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(233, 232, 241, 0.1);
  }
  
  .date {
    font-variant-numeric: tabular-nums;
  }
  
  .venue {
    font-weight: 700;
    color: var(--flush-yellow, #ffe600);
  }
  
  /* Fixed long title constraint: allows breaking and wrapping naturally */
  .event-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .event {
    overflow-wrap: break-word;
  }

  .genre {
    opacity: 0.6;
    font-size: 0.9em;
  }

  .link {
    white-space: nowrap;
  }

  .no-link {
    opacity: 0.4;
    text-align: right;
  }
  
  .muted {
    opacity: 0.8;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-bottom: 1.5rem;
    }
    .date, .venue, .event-wrapper {
      grid-column: 1 / -1;
    }
    .link {
      margin-top: 0.5rem;
    }
  }
</style>
