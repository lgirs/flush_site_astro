---
import BaseLayout from "../../layouts/BaseLayout.astro";
import intertainmentData from "../../data/intertainment-links.json";

export const pageTitle = "Intertainment";
export const pageTags = ["Extras", "Links"];
---

<BaseLayout title={pageTitle} description="A collection of fun and interesting websites.">
  <h1>{pageTitle}</h1>
  <p class="long-text">
    A curated collection of fun, weird, and wonderful things from the interwebs that we think you'll enjoy.
  </p>

  <div class="link-grid">
    {intertainmentData.map(item => (
      <div class="link-card">
        <h2>
          <a href={item.url} target="_blank" rel="noopener" class="link-title">
            {item.headline} <span class="external-icon">↗</span>
          </a>
        </h2>
        {item.annotation && <p class="annotation">{item.annotation}</p>}
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .link-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(233, 232, 241, 0.08);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .link-card:hover {
    border-color: rgba(233, 232, 241, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  .link-card h2 {
    margin: 0 0 0.35rem 0;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .link-title {
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35ch;
  }

  .link-title:hover {
    color: var(--flush-yellow, #ffe600);
  }

  .external-icon {
    font-size: 0.75rem;
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .link-title:hover .external-icon {
    opacity: 1;
    color: var(--flush-yellow, #ffe600);
  }

  .annotation {
    font-family: "Montserrat", sans-serif;
    font-size: 0.85rem;
    opacity: 0.65;
    margin: 0;
    line-height: 1.35;
  }
</style>
